# PRAVIA OS — Environment Variables

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/pravia_os"
DIRECT_URL="postgresql://user:password@localhost:5432/pravia_os"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="24h"

# Server
PORT=3001
NODE_ENV=development

# AI documental (solo backend; nunca exponer la clave en el frontend)
AI_DOCUMENT_PROVIDER=OPENAI
AI_DOCUMENT_MODEL=gpt-5-mini
OPENAI_DOCUMENT_MODEL=gpt-5-mini
OPENAI_API_KEY=""
AI_DOCUMENT_TIMEOUT_MS=120000
AI_DOCUMENT_MAX_RETRIES=2
